# Vendored engine tracks must stay byte-exact (their sha256 is recorded in
# vendor/tracks_frozen/PROVENANCE.md): no line-ending conversion on checkout.
vendor/tracks_frozen/*.json -text
# Engine-format exports: their sha256 is checked byte-for-byte by the backend.
exports/*.json -text
# WSL runs these; a CRLF checkout breaks bash.
*.sh text eol=lf
# Engine recording fixture: keep byte-exact (its header records the source sha256).
public/recordings/*.jsonl -text
