  'backend/model_train/race_diagnostic.py',
  'backend/scripts/run_race_10_cars.py',
]
for rel in paths:
  p = Path(rel)
  disk = hashlib.sha256(p.read_bytes()).hexdigest()
  pinned = subprocess.run(['git','show','HEAD:'+rel], check=True,
                          capture_output=True).stdout
  via_git = hashlib.sha256(pinned).hexdigest()
  print(rel, 'disk='+disk, 'git-show='+via_git, 'match='+str(disk==via_git))
