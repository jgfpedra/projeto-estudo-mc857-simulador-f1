# Dev image with hot reload via uvicorn --reload
FROM python:3.11-slim

WORKDIR /app/backend

# System deps for fastf1, pybullet, etc. (Debian 13 / trixie package names)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gcc \
    g++ \
    libglib2.0-0 \
    libgl1 \
    libegl1 \
    libgles2 \
    libx11-6 \
    libxcb1 \
    libxkbcommon0 \
    libxrender1 \
    libxext6 \
    libxi6 \
    libsm6 \
    libice6 \
    libxrandr2 \
    libxfixes3 \
    libxcb-cursor0 \
    libxcb-render0 \
    libxcb-shape0 \
    libxcb-xfixes0 \
    libxcb-xkb1 \
    libxkbcommon-x11-0 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

EXPOSE 8000