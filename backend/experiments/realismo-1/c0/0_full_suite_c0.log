            v = phys["speed_mps"]
            env_eval.engine.set_driver_input(
                env_eval.driver_id, target_speed_mps=20.0,
                throttle=1.0 if v < 20 else 0.0, brake=0.5 if v > 22 else 0.0,
                steering_yaw_rad=math.radians(15), grip_override=1.0)
