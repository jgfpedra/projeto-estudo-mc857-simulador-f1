3) Recontagem apenas das métricas de gate R4 a partir do CSV, sem classificar
eventos de projeção e sem reexecutar a anatomia 112/50/45:

cd backend
python - <<'PY'
import numpy as np, pandas as pd
df = pd.read_csv('experiments/fail-forensics-2/4_composite_monaco_s0.csv', comment='#')
print('rows/ticks/cars', len(df), df.tick.nunique(), df.drv.nunique())
print('outside', int(df.offtrack.sum()), '/', len(df), 100*df.offtrack.mean())
episodes = windows = 0
for _, g in df.groupby('drv', sort=True):
  g = g.sort_values('tick')
  off = g.offtrack.to_numpy(dtype=int)
  episodes += int(np.sum((off == 1) & np.r_[True, off[:-1] == 0]))
  t, lat = g.t_s.to_numpy(float), np.abs(g.lat.to_numpy(float))
  cum = g.cum_dist.to_numpy(float)
  for w0 in np.arange(0.0, float(t.max()), 30.0):
    m = (t >= w0) & (t < w0 + 30.0)
    if m.any() and off[m].any() and (lat[m].max() > 20.0 or
                                     cum[m].max()-cum[m].min() < 5.0):
      windows += 1
hesitations = 0
for _, g in df.groupby('drv', sort=True):
  g = g.sort_values('t_s')
  t, v = g.t_s.to_numpy(float), g.speed.to_numpy(float)
  m = t > 20.0
  t, v = t[m], v[m]
  i = 0
  while i < len(v):
    if v[i] >= 0.5:
      i += 1
      continue
    j = i
    while j < len(v) and v[j] < 0.5:
      j += 1
    duration = t[min(j, len(t)-1)] - t[i] if j > i else 0.0
    hesitations += int(0.3 <= duration < 3.0)
    i = j
print('episodes/windows/hesitations', episodes, windows, hesitations)
PY

