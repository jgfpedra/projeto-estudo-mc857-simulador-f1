from pathlib import Path
import hashlib, subprocess
paths = [
  'backend/model_train/tracks_frozen/Monaco_v2.json',
  'backend/experiments/proj-fix-1/DOSSIÊ_PROJ_GATE.md',
  'backend/experiments/fail-forensics-2/4_composite_monaco_s0.csv',
  'backend/experiments/fail-forensics-2/4_composite_monaco_s0_events.csv',
